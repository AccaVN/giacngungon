{
  // Cấu hình deploy lên Cloudflare Workers (static assets)
  "name": "giacngungon",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "pip install -q -r requirements.txt && python3 build.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
